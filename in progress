<script>
const today = new Date();
let start_time =
  ("0" + today.getHours()).slice(-2) +
  ":" +
  ("0" + today.getMinutes()).slice(-2);
let end_time;
let pausa = 0;

$("#start_time").val(start_time);

$(document).ready(function () {
  $("#start_time").on("change", () => {
    start_time = $("#start_time").val();
    countHours();
  });
  $("#end_time").on("change", () => {
    end_time = $("#end_time").val();
    countHours();
  });
  $("#pausa").on("change", () => {
    pausa = $("#pausa").val();
    countHours();
  });
});

function countHours() {
  // start_time to minutes
  let start_min =
    Number(start_time.slice(0, 2)) * 60 + Number(start_time.slice(3, 5));
  let end_min =
    Number(end_time.slice(0, 2)) * 60 + Number(end_time.slice(3, 5));
  let hours = (end_min - start_min - Number(pausa)) / 60;
  let round_hours = Math.floor(hours);
  let round_minutes = Math.floor((hours - round_hours) * 60);
  $("#total_time").html(round_hours + "h " + round_minutes + "m");
}
</script>
