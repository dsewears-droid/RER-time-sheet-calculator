<script>



function updateDayOfWeek(dateString) {

    const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

    const selectedDate = new Date(dateString + 'T00:00:00');

    const dayIndex = selectedDate.getDay();

    document.getElementById('weekDay').value = dayNames[dayIndex];

}



// Run when the user changes the date

document.getElementById('workDate').addEventListener('change', function() {

    updateDayOfWeek(this.value);

});



// Optional: set today’s date and day automatically when page loads

window.onload = function() {

    const today = new Date().toISOString().split('T')[0];

    document.getElementById('workDate').value = today;

    updateDayOfWeek(today);

};

